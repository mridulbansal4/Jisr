# ---------- Shared ----------
APP_ENV=development                 # development | staging | production
DEMO_MODE=true                      # enables Judge Mode login + seeded personas (never true in production)

# ---------- API (services/api) ----------
DATABASE_URL=postgresql+psycopg://jisr:jisr@localhost:5432/jisr   # local docker compose; SQLite fallback: sqlite:///./jisr.db
JWT_SECRET=change-me-32-bytes-minimum      # signs demo-login tokens
JWT_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:3000
RULES_DIR=../../packages/rules             # versioned JSON rules
SLA_RED_MINUTES=15                          # RED episode: on-call clinician must acknowledge within
SLA_REFERRAL_ACCEPT_HOURS=48                # provider must accept/decline a referral within
SLA_FIRST_APPOINTMENT_DAYS=14               # target days from positive screen to first appointment
RECHECK_DAYS=14                             # re-screen interval for measurement-based care
SLA_STEP_CONFIRM_HOURS=48                  # clinician must confirm a recommended step within
SMALL_CELL_K=10
JOBS_ENABLED=true                   # run APScheduler SLA/escalation jobs in this process (exactly one instance)                             # fairness/dashboard suppression threshold

# ---------- LLM (explain-only; never decides) ----------
LLM_PROVIDER=gemini                 # gemini | azure_openai | local | none  (none = templates only, fully offline)
GEMINI_API_KEY=                     # from https://aistudio.google.com/ ; synthetic data only (no UAE processing guarantee)
GEMINI_MODEL=gemini-3.6-flash       # pinned; prices double 1 Jan 2027 (check ai.google.dev/pricing). Use a paid-tier key
LLM_TIMEOUT_SECONDS=6
LLM_CRISIS_SECOND_OPINION=false     # M-02 raise-only crisis classifier
AZURE_OPENAI_ENDPOINT=              # v1 in-country option (UAE North)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama with an Arabic-capable open model

# ---------- Notifications (mocked in MVP) ----------
NOTIFY_CHANNELS=inapp,sms_mock      # inapp | sms_mock | whatsapp_mock
CRISIS_LINES=999,800725462,8004673  # emergency, 800-SAKINA, 800-HOPE

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ar        # ar | en | ur
NEXT_PUBLIC_DEMO_MODE=true

# ---------- Observability ----------
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=         # optional

# ---------- Feature flags ----------
FF_CSSRS_ITEMS=false                # C-SSRS screener items (off until licence terms confirmed, R-05)
FF_READ_ALOUD=true                  # F-20 browser TTS
FF_PHYSICAL_CONTEXT=true            # F-12 coordinated care summary
FF_SIMULATION=true                  # F-16 baseline-vs-Jisr simulation
FF_SAHATNA_LAUNCH=false             # F-19 launch stub

# ---------- Demo / safety ----------
JUDGE_PASSCODE=jisr-demo           # shared passcode for Judge Mode login (change before deploying; give to judges in the submission form)
CRISIS_FAILSAFE=red                 # behaviour if the Crisis Gate errors/times out: always 'red' (fail-closed)
NEXT_PUBLIC_OFFLINE_DEMO=false      # true = web runs from bundled seed data if the API is unreachable (demo-day fallback)
LOG_PEPPER=change-me                # pepper for hashing IDs in logs
