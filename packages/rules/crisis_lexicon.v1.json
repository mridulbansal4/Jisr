    {"id": "GRD-AZ-02", "lang": "ar-latn", "pattern": "\\b(ba|a|b)?(g|q|8|k)t[ie]l\\s+nafs[iy]\\s+(mn|min|bil|bel)\\s+(el|al|il)?\\s*(dirasa|drasa|dawam|shoghl|mathakra|imti7an(at)?)\\b", "note": "'kill myself studying / working' in Arabizi (guards AZ-007)."}
