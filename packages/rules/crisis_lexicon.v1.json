    {"id": "GRD-EN-03", "lang": "en", "pattern": "\\b((wa+nts?|wanna)\\s+(to\\s+)?di+e+|kill\\s+(him|her|them))\\s+(laughing|of\\s+laughter)\\b"},
    {"id": "GRD-EN-04", "lang": "en", "pattern": "\\bsuicide\\s+(prevention|awareness)(\\s+(prevention|awareness))?\\s+(day|week|month|talk|training|workshop|campaign|session|event)\\b", "note": "Institutional awareness events only (guards EN-013). Does NOT cover hotline/helpline mentions."},
    {"id": "GRD-AR-01", "lang": "ar", "pattern": "((ابي+|ابغي+|ابا|ودي+|اريد|تبي|يبي)\\s*(ان\\s*)?)?(راح\\s*)?(ا|ب|ت|ي)?مو+ت\\s*(من|م)\\s*(الضحك|الفشله|الجوع|الملل)", "note": "'I'll die / I want to die of laughter / embarrassment / hunger / boredom'. v1.1: covers the 'ابي/ودي' prefix so AR-002 hits are fully contained."},
    {"id": "GRD-AR-02", "lang": "ar", "pattern": "(اقتل|بقتل)\\s*نفسي\\s*(دراسه|من\\s*الدراسه|شغل|من\\s*الشغل|رياضه)", "note": "'kill myself studying / working'"},
