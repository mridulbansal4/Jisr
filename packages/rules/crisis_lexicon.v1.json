{
  "$schema_note": "Jisr Crisis Gate phrase lexicon. Loaded by services/api/app/engines/crisis_gate.py. Deterministic matching on normalised text. Raise-only: a match can create a RED flag; nothing in this file can clear one.",
  "id": "crisis_lexicon",
  "version": "1.1.0",
  "sources": ["Jisr team original phrase list (see licence and review_log); evaluated in docs/04-ai/AI_EVALS.md and data/synthetic/crisis_benchmark.v1.jsonl"],
  "status": "DRAFT — NOT CLINICALLY REVIEWED. Every entry needs review by a native-speaking mental-health clinician for each language (Gulf Arabic, MSA, Arabizi, Urdu, Roman Urdu, English) before any non-synthetic use. Owner: Clinical lead. Tracked as R-01 / R-04.",
  "last_updated": "2026-11-19",
  "licence": "Jisr original work (team). Entries are short common phrases, not taken from copyrighted lists.",
  "normalisation": {
    "order": [
      "Unicode NFKC",
      "strip zero-width / invisible format characters (U+00AD, U+200B-U+200F, U+2060, U+FEFF) - added v1.1.0",
      "lowercase (Latin)",
      "strip Arabic diacritics (U+064B-U+0652, U+0670) and tatweel (U+0640)",
      "Arabic letter folding: أ إ آ ٱ -> ا ; ة -> ه ; ى -> ي ; ؤ -> و ; ئ -> ي",
      "Urdu/Persian folding: ی ي -> ي ; ک ك -> ك ; ہ ھ ة -> ه ; ۓ ے -> ي (for matching only). Noon ghunna ں is NOT folded (patterns accept both ں and ن explicitly)",
      "Arabizi digits kept as letters: 2 (hamza), 3 (ain), 5 (kha), 6 (ta), 7 (ha), 8 (qaf/ghain), 9 (sad); also fold 'ou'->'u', 'ee'->'i', 'oo'->'u'",
      "collapse repeated characters > 2 (e.g. 'diiiie' -> 'diie', 'ابييي' -> 'ابيي')",
      "collapse whitespace; remove punctuation except apostrophe",
      "Eastern Arabic and Urdu digits -> ASCII digits"
    ],
    "implementation_note": "Both the lexicon patterns and the input text pass through the SAME normaliser (packages/rules is the single source; the Python engine and the Vitest mirror must share golden tests)."
  },
  "matching_policy": {
    "pattern_type": "Python 're' regex applied to normalised text with word boundaries where the script allows; Arabic/Urdu patterns use (?<!\\S) and (?!\\S) style boundaries.",
    "negation": "Negation does NOT suppress a match (e.g. 'I am not going to kill myself' still fires). Rationale: recall first (R-01); negated disclosures are themselves clinically relevant; precision target is >= 80%, not 100%.",
    "quotation": "Quoted text, song lyrics and reported speech are NOT suppressed by default. Only entries in 'false_positive_guards' can suppress, and only when the guard pattern fully covers the matched span.",
    "guard_rule": "A guard suppresses a hit only if (a) the hit's entry has 'guardable': true AND (b) the guard regex span contains the hit span. Entries with severity 'imminent' are never guardable.",
    "multi_hit": "All hits are returned with entry id, category, severity and character span (span is used only in memory for UI highlighting; free text is never logged).",
    "latency_budget_ms": 50,
    "fail_closed": "If normalisation, regex compilation or file loading fails, or matching exceeds the timeout, the gate returns RED (step_rules CG-00). Never 'no match'.",
    "storage": "F-22 free text: persist only {gate_result, category, entry_id}. Raw text is persisted only with the 'store free text' consent scope and is never logged."
  },
  "categories": {
    "SI_EXPLICIT": "Explicit suicidal ideation or intent",
    "SI_PASSIVE": "Passive death wish / wish not to wake up",
    "PLAN_MEANS": "Plan, means, preparation or timing",
    "SELF_HARM": "Non-suicidal or unspecified self-harm",
    "FAREWELL": "Farewell, finality, putting affairs in order",
    "BURDEN_HOPELESS": "Perceived burdensomeness or hopelessness",
    "HARM_OTHERS": "Intent to harm another person",
    "SAFETY_ABUSE": "Being harmed / unsafe at home"
  },
  "severity_levels": {
    "imminent": "Plan, means, timing, or intent stated now. RED, 999 shown first. Never guardable.",
    "high": "Explicit or strongly indirect ideation. RED.",
    "moderate": "Indirect / hopelessness phrases with lower specificity. RED (MVP is recall-first); flagged for precision review in AI_EVALS."
  },
  "entries": [
    {"id": "EN-001", "lang": "en", "script": "latin", "text": "kill myself", "pattern": "\\bkil+(ing)?\\s+m[yi]\\s*(self|slef|sefl|sef)\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "notes": "v1.1: tolerates 'kil' and 'myslef' typos."},
    {"id": "EN-002", "lang": "en", "script": "latin", "text": "want to die", "pattern": "\\b(wa+nts?|wanted|wanna|wish(ed)?)\\s+(to\\s+)?di+e+\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "notes": "v1.1: 'wants' (third person) and elongation ('diiie' normalises to 'diie')."},
    {"id": "EN-003", "lang": "en", "script": "latin", "text": "end it all", "pattern": "\\bend(ing)?\\s+(it\\s+all|my\\s+(own\\s+)?life|everything)\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "notes": "v1.1: 'ending my (own) life'."},
    {"id": "EN-004", "lang": "en", "script": "latin", "text": "better off without me", "pattern": "\\b(better\\s+off\\s+without\\s+me|better\\s+off\\s+dead)\\b", "category": "BURDEN_HOPELESS", "severity": "high", "guardable": false},
    {"id": "EN-005", "lang": "en", "script": "latin", "text": "go to sleep and not wake up", "pattern": "\\b(not|never|don'?t)\\s+wake\\s+up\\b", "category": "SI_PASSIVE", "severity": "high", "guardable": false},
    {"id": "EN-006", "lang": "en", "script": "latin", "text": "no reason to live", "pattern": "\\bno\\s+(reason|point)\\s+(to|in)\\s+(live|living|going\\s+on)\\b", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false},
    {"id": "EN-007", "lang": "en", "script": "latin", "text": "saving up pills", "pattern": "\\b(sav(ed|ing)\\s+up|stockpil(ed|ing)|collect(ed|ing))\\s+(my\\s+)?(pills|tablets|meds)\\b", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false},
    {"id": "EN-008", "lang": "en", "script": "latin", "text": "wrote a goodbye note", "pattern": "\\b(goodbye|suicide)\\s+(note|letter)\\b", "category": "FAREWELL", "severity": "imminent", "guardable": false},
    {"id": "EN-009", "lang": "en", "script": "latin", "text": "cut myself", "pattern": "\\b(cut|cutting|burn|burning|hurt|hurting)\\s+my\\s*self\\b", "category": "SELF_HARM", "severity": "high", "guardable": false},
    {"id": "EN-010", "lang": "en", "script": "latin", "text": "unalive / kms", "pattern": "\\b(unalive\\s+my\\s*self|kms)\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "notes": "Online euphemisms. 'kms' may need a guard after review."},
    {"id": "EN-011", "lang": "en", "script": "latin", "text": "tonight is the night", "pattern": "\\b(tonight|today)\\s+(is\\s+the\\s+night|i\\s+(will|am\\s+going\\s+to)\\s+do\\s+it)\\b", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false},
    {"id": "EN-012", "lang": "en", "script": "latin", "text": "hurt someone (harm to others)", "pattern": "\\b(going\\s+to|want\\s+to)\\s+(hurt|kill)\\s+(him|her|them|someone)\\b", "category": "HARM_OTHERS", "severity": "high", "guardable": true},
    {"id": "EN-013", "lang": "en", "script": "latin", "text": "suicide / suicidal", "pattern": "\\bsuicid(e|al|ally)\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "notes": "Any mention. Guardable only by GRD-EN-04 (institutional awareness events)."},
    {"id": "EN-014", "lang": "en", "script": "latin", "text": "don't want to be alive", "pattern": "\\b(don'?t|dont|do\\s+not)\\s+want\\s+to\\s+(be\\s+alive|exist|live\\b(?!\\s+(with|in|at|near|there|here|alone)))", "category": "SI_PASSIVE", "severity": "high", "guardable": false},
    {"id": "EN-015", "lang": "en", "script": "latin", "text": "want to disappear forever", "pattern": "\\b(want|wish|wanna)\\s+(to\\s+|i\\s+could\\s+)?disappear\\s+(forever|for\\s+good|permanently)\\b", "category": "SI_PASSIVE", "severity": "high", "guardable": false},
    {"id": "EN-016", "lang": "en", "script": "latin", "text": "I'm a burden", "pattern": "\\b(i'?m|im|i\\s+am|feel\\s+like\\s+(i'?m\\s+)?)\\s*(just\\s+|such\\s+)?a\\s+burden\\b", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false},
    {"id": "EN-017", "lang": "en", "script": "latin", "text": "noose / tied the rope", "pattern": "\\b(noose|tied\\s+(a|the)\\s+rope)\\b", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false},
    {"id": "EN-018", "lang": "en", "script": "latin", "text": "took a whole bottle of pills", "pattern": "\\b(took|swallowed|taken)\\s+(a\\s+whole\\s+bottle|all\\s+(of\\s+)?(my|the))\\s+(of\\s+)?(pills|tablets|meds|medication)\\b", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false},
    {"id": "EN-019", "lang": "en", "script": "latin", "text": "cuts herself (reported self-harm)", "pattern": "\\b(cuts?|cutting|burns?|burning)\\s+(her|him|them)sel(f|ves)\\b", "category": "SELF_HARM", "severity": "high", "guardable": false, "notes": "Third-person self-harm report; policy keeps third person RED."},
    {"id": "EN-020", "lang": "en", "script": "latin", "text": "husband hits me", "pattern": "\\b(husband|father|dad|brother|partner|wife|mother|mum|mom|uncle)\\s+(hits|beats|hit|beat|chokes|choked|threatens|threatened|hurts)\\s+me\\b", "category": "SAFETY_ABUSE", "severity": "high", "guardable": false},
    {"id": "EN-021", "lang": "en", "script": "latin", "text": "nobody would miss me", "pattern": "\\b(no\\s*one|nobody)\\s+(would|will)\\s+(even\\s+)?(miss|notice)\\s+(me|if\\s+i)\\b", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false},
    {"id": "AR-001", "lang": "ar", "script": "arabic", "dialect": "gulf/msa", "text": "أفكر أنتحر", "pattern": "(افكر|ابي|ابغي|بغيت|ودي|راح)?\\s*(ا|ب)?نتحا*ر", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "gloss_en": "I'm thinking of killing myself", "notes": "v1.1: also matches the noun انتحار / بالانتحار (was verb-only)."},
    {"id": "AR-002", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "أبي أموت", "pattern": "(ابي+|ابغي+|ابا|ودي+|اتمني|اريد|اود|تبي|يبي|تبغي|يبغي)\\s*(ان\\s*)?(ا|ب|ت|ي)?مو+ت", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "gloss_en": "I want to die", "notes": "v1.1: elongation (ابيي امووت), MSA اريد ان اموت, third person تبي تموت. Guard GRD-AR-01."},
    {"id": "AR-003", "lang": "ar", "script": "arabic", "dialect": "msa", "text": "أتمنى الموت", "pattern": "اتمني\\s*الموت", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I wish for death"},
    {"id": "AR-004", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "ما أبي أعيش", "pattern": "(ما|مب|مو)\\s*(عاد\\s*)?(ابي|ابغي|ودي)\\s*(اعيش|اكون\\s*موجود)", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I don't want to live", "notes": "v1.1: 'ما عاد' and 'اكون موجود(ة)'."},
    {"id": "AR-005", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "ودي أنام وما أصحى", "pattern": "انام\\s*و?\\s*(ما|لا)\\s*(اصحي|اقوم|اصحا)", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I wish I'd sleep and not wake up (indirect)"},
    {"id": "AR-006", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "الكل بيرتاح مني", "pattern": "(بيرتاحون|بيرتاح|بترتاحون|يرتاحون)\\s*مني", "category": "BURDEN_HOPELESS", "severity": "high", "guardable": false, "gloss_en": "Everyone will be relieved of me (indirect burden)"},
    {"id": "AR-007", "lang": "ar", "script": "arabic", "dialect": "msa/gulf", "text": "تعبت من الحياة", "pattern": "(تعب+ت|مليت|زهقت)\\s*(من)?\\s*(الحيا+ه|حياتي|العيشه)", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false, "gloss_en": "I'm tired of life", "notes": "v1.1: elongation."},
    {"id": "AR-008", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "بقتل نفسي", "pattern": "(راح\\s*)?(اقتل|قتل|بقتل)\\s*نفسي", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "gloss_en": "I'll kill myself", "notes": "Also used hyperbolically ('I'll kill myself studying'); guard GRD-AR-02."},
    {"id": "AR-009", "lang": "ar", "script": "arabic", "dialect": "msa/gulf", "text": "أجرح نفسي", "pattern": "(اجرح|جرحت|اذي|اذيت|اضر|احرق|حرقت)\\s*(نفسي|يدي|ايدي|جسمي)", "category": "SELF_HARM", "severity": "high", "guardable": false, "gloss_en": "I hurt / cut myself", "notes": "v1.1: burning; body-part objects."},
    {"id": "AR-010", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "جمعت حبوب", "pattern": "(جمعت|خزنت|شريت)\\s*(حبوب|ادويه|دوا)", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false, "gloss_en": "I've collected pills"},
    {"id": "AR-011", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "سامحوني على كل شي", "pattern": "سامحوني\\s*(علي|ع)\\s*كل\\s*شي", "category": "FAREWELL", "severity": "high", "guardable": false, "gloss_en": "Forgive me for everything (farewell)"},
    {"id": "AR-012", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "الله ياخذني", "pattern": "(الله|يا\\s*رب|يارب)\\s*(ياخذني|تاخذني|خذني|ياخذ\\s*روحي|تاخذ\\s*روحي|خذ\\s*روحي|يخلصني)", "category": "SI_PASSIVE", "severity": "moderate", "guardable": true, "gloss_en": "May God take me", "notes": "Often exasperation; kept as moderate RED for recall. Prime precision-review candidate. v1.1: 'يا رب خذ روحي'."},
    {"id": "AR-013", "lang": "ar", "script": "arabic", "dialect": "msa", "text": "لا فائدة من حياتي", "pattern": "(ما|لا)\\s*(في|فيه)?\\s*فايده\\s*(من)?\\s*(حياتي|عيشتي)", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false, "gloss_en": "There's no point to my life"},
    {"id": "AR-014", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "أبي أختفي للأبد", "pattern": "(ابي|ابغي|ودي)\\s*اختفي\\s*(للابد|من\\s*الدنيا)", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I want to disappear forever"},
    {"id": "AR-015", "lang": "ar", "script": "arabic", "dialect": "gulf", "text": "زوجي يضربني", "pattern": "(زوجي|ريلي|ابوي|اخوي)\\s*(يضربني|ضربني|يهددني)", "category": "SAFETY_ABUSE", "severity": "high", "guardable": false, "gloss_en": "My husband/father/brother hits or threatens me"},
    {"id": "AR-016", "lang": "ar", "script": "arabic", "text": "أنهي حياتي", "pattern": "(انهي|بنهي|انهاء)\\s*حياتي", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "dialect": "msa/gulf", "gloss_en": "End my life"},
    {"id": "AR-017", "lang": "ar", "script": "arabic", "text": "قررت أنتحر / أنهي حياتي", "pattern": "قررت\\s*(انتحر|انهي\\s*حياتي|اموت)", "category": "PLAN_MEANS", "severity": "imminent", "guardable": false, "dialect": "msa/gulf", "gloss_en": "I've decided to kill myself / end my life"},
    {"id": "AR-018", "lang": "ar", "script": "arabic", "text": "بخلص على عمري", "pattern": "(اخلص|بخلص)\\s*(علي|ع)\\s*(عمري|نفسي)", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "dialect": "gulf", "gloss_en": "I'll finish myself off"},
    {"id": "AR-019", "lang": "ar", "script": "arabic", "text": "الموت أرحم", "pattern": "الموت\\s*ارحم", "category": "SI_PASSIVE", "severity": "moderate", "guardable": false, "dialect": "msa/gulf", "gloss_en": "Death would be more merciful"},
    {"id": "AR-020", "lang": "ar", "script": "arabic", "text": "إني عبء على أهلي", "pattern": "(اني|انا|صرت)\\s*عبء|عبء\\s*(علي|ع)\\s*(اهلي|الكل|عيالي|الناس|زوجي|امي|ابوي|عايلتي)", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false, "dialect": "msa/gulf", "gloss_en": "I am a burden (on my family)"},
    {"id": "AR-021", "lang": "ar", "script": "arabic", "text": "رسالة وداع", "pattern": "رساله\\s*وداع", "category": "FAREWELL", "severity": "imminent", "guardable": false, "dialect": "msa/gulf", "gloss_en": "Farewell letter", "notes": "Same FP risk as EN-008 (leaving-do messages); recall first."},
    {"id": "AR-022", "lang": "ar", "script": "arabic", "text": "بذبحه / بقتله", "pattern": "(بذبح|بقتل|راح\\s*اذبح|راح\\s*اقتل|ابي\\s*اذبح|ابي\\s*اقتل)(ه|ها|هم)(?!\\S)", "category": "HARM_OTHERS", "severity": "high", "guardable": true, "dialect": "gulf", "gloss_en": "I'll slaughter / kill him", "notes": "Also hyperbolic in Gulf speech; guardable."},
    {"id": "AZ-001", "lang": "ar-latn", "script": "arabizi", "text": "abi amoot", "pattern": "\\b(abi+|abgha|aba|wdi|widdi|tabi|yabi)\\s+(a|t|y|ba)?mo+t\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "gloss_en": "I want to die", "notes": "v1.1: elongation (abii amoot), third person (tabi tmoot). Guard GRD-AZ-01."},
    {"id": "AZ-002", "lang": "ar-latn", "script": "arabizi", "text": "bant7ir / abi anta7ir", "pattern": "\\b(b|a|y|t)?nta7(i|e)r\\b|\\b(bil|bel|el|al|il)?\\s*[ie]nt[ie]7a+r\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": false, "gloss_en": "I'll kill myself / suicide", "notes": "v1.1: noun form inti7ar / bil inti7ar."},
    {"id": "AZ-003", "lang": "ar-latn", "script": "arabizi", "text": "ma abi a3eesh", "pattern": "\\b(ma|mob|mu)\\s+(abi|abgha|wdi)\\s+a3ee?sh\\b", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I don't want to live"},
    {"id": "AZ-004", "lang": "ar-latn", "script": "arabizi", "text": "ta3abt mn el 7ayah", "pattern": "\\b(ta3abt|maleet|zehe?gt)\\s+(min|mn)\\s+(el|al|il)?\\s*7aya?h?\\b", "category": "BURDEN_HOPELESS", "severity": "moderate", "guardable": false, "gloss_en": "I'm tired of life"},
    {"id": "AZ-005", "lang": "ar-latn", "script": "arabizi", "text": "wdi anam w ma ats7a", "pattern": "\\banam\\s+(w|wa)\\s+ma\\s+(at?s7a|agoom)\\b", "category": "SI_PASSIVE", "severity": "high", "guardable": false, "gloss_en": "I wish I'd sleep and not wake up"},
    {"id": "AZ-006", "lang": "ar-latn", "script": "arabizi", "text": "kil7ad bi yirta7 minni", "pattern": "\\b(bi|b)?\\s*(yirta7oon|yirta7|yrta7on)\\s+(minni|mni)\\b", "category": "BURDEN_HOPELESS", "severity": "high", "guardable": false, "gloss_en": "Everyone will be relieved of me"},
    {"id": "AZ-007", "lang": "ar-latn", "script": "arabizi", "text": "bagtil nafsi", "pattern": "\\b(ba|a|b)?(g|q|8|k)t[ie]l\\s+nafs[iy]\\b", "category": "SI_EXPLICIT", "severity": "high", "guardable": true, "gloss_en": "I'll kill myself", "notes": "Guard GRD-AZ-02 for studying/work hyperbole."},
    {"id": "AZ-008", "lang": "ar-latn", "script": "arabizi", "text": "jara7t nafsi", "pattern": "\\b(jara7t|ajra7|a2thi|a2zi|athi|7ara8t|a7ra8)\\s+(nafsi|eedi|idi|yadi)\\b", "category": "SELF_HARM", "severity": "high", "guardable": false, "gloss_en": "I hurt / cut / burn myself"},
